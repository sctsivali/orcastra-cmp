"use client";

import { useState, useEffect } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { Network, Loader2, RotateCw } from "lucide-react";
import { NetworkInfo, NetworkListResponse } from "@/types/api";
import { useToast } from "@/hooks/use-toast";
import { API_URL } from "@/lib/api";

export default function NetworksPage() {
  const [networks, setNetworks] = useState<NetworkInfo[]>([]);
  const [loading, setLoading] = useState(true);
  const { toast } = useToast();

  useEffect(() => {
    fetchNetworks();
  }, []);

  const fetchNetworks = async () => {
    try {
      setLoading(true);
      const response = await fetch(`${API_URL}/networks`);
      if (!response.ok) throw new Error("Failed to fetch networks");
      const data: NetworkListResponse = await response.json();
      setNetworks(data.networks);
    } catch (error) {
      toast({
        title: "Error",
        description: "Failed to fetch networks",
        variant: "destructive",
      });
    } finally {
      setLoading(false);
    }
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center h-screen">
        <Loader2 className="h-8 w-8 animate-spin" />
      </div>
    );
  }

  return (
    <div className="p-8 space-y-6">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-3xl font-bold flex items-center gap-2">
            <Network className="h-8 w-8" />
            Networks
          </h1>
          <p className="text-muted-foreground mt-2">
            Manage LXD networks
          </p>
        </div>
        <Button onClick={fetchNetworks}>
          <RotateCw className="h-4 w-4 mr-2" />
          Refresh
        </Button>
      </div>

      <Card>
        <CardHeader>
          <CardTitle>All Networks ({networks.length})</CardTitle>
        </CardHeader>
        <CardContent>
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>Name</TableHead>
                <TableHead>Type</TableHead>
                <TableHead>Description</TableHead>
                <TableHead>Managed</TableHead>
                <TableHead>Status</TableHead>
                <TableHead>Used By</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {networks.map((network) => (
                <TableRow key={network.name}>
                  <TableCell className="font-medium">{network.name}</TableCell>
                  <TableCell>
                    <Badge variant="outline">{network.type}</Badge>
                  </TableCell>
                  <TableCell>{network.description || "N/A"}</TableCell>
                  <TableCell>
                    {network.managed ? (
                      <Badge variant="default">Managed</Badge>
                    ) : (
                      <Badge variant="secondary">Unmanaged</Badge>
                    )}
                  </TableCell>
                  <TableCell>
                    <Badge variant="default">{network.status || "Active"}</Badge>
                  </TableCell>
                  <TableCell>
                    <Badge variant="outline">
                      {network.used_by?.length || 0} instances
                    </Badge>
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </CardContent>
      </Card>
    </div>
  );
}
