"""
LXD Service for managing connections to multiple LXD nodes.
Handles all pylxd operations including VM lifecycle management.
"""

import logging
from typing import Dict, List, Optional, Tuple, Any
from datetime import datetime
import time
import pylxd
from pylxd.exceptions import LXDAPIException, NotFound
from requests.adapters import HTTPAdapter
from urllib3.util.retry import Retry

from app.core.config import get_settings, LXDNodeConfig
from app.models.schemas import (
    VMStatus,
    VMInfo,
    ResourceUsage,
    ImageInfo,
    NodeStatus,
    NodeResources,
    InstanceMetrics,
)

logger = logging.getLogger(__name__)


class LXDConnectionError(Exception):
    """Exception raised when LXD connection fails."""
    pass


class LXDOperationError(Exception):
    """Exception raised when an LXD operation fails."""
    pass


class LXDService:
    """
    Service for managing LXD connections and operations across multiple nodes.
    Implements connection pooling and provides unified interface for VM management.
    """
    
    def __init__(self):
        self.settings = get_settings()
        self._clients: Dict[str, pylxd.Client] = {}
        self._node_configs: Dict[str, LXDNodeConfig] = {}
        # CPU usage tracking: {"host:instance": {"usage_ns": int, "timestamp": float}}
        self._cpu_history: Dict[str, Dict[str, any]] = {}
        # Track connection creation time for refresh: {"node_name": timestamp}
        self._connection_times: Dict[str, float] = {}
        # Connection refresh interval (30 minutes in seconds) - reduced to prevent stale connections
        self._connection_refresh_interval = 1800
        self._initialize_nodes()
    
    def _initialize_nodes(self) -> None:
        """Initialize node configurations."""
        self._node_configs = {
            self.settings.lxd_node1_name: self.settings.get_node1_config(),
            self.settings.lxd_node2_name: self.settings.get_node2_config(),
        }
    
    def _create_http_session(self):
        """
        Create HTTP session with proper timeout, keep-alive and retry configuration.
        """
        import requests
        from requests.adapters import HTTPAdapter
        from urllib3.util.retry import Retry
        
        session = requests.Session()
        
        # Configure retry strategy
        retry_strategy = Retry(
            total=3,
            backoff_factor=1,
            status_forcelist=[429, 500, 502, 503, 504],
            allowed_methods=["HEAD", "GET", "OPTIONS", "POST", "PUT", "DELETE"],
            raise_on_status=False
        )
        
        adapter = HTTPAdapter(
            max_retries=retry_strategy,
            pool_connections=10,
            pool_maxsize=20,
            pool_block=False
        )
        
        session.mount("http://", adapter)
        session.mount("https://", adapter)
        
        # Enable TCP keep-alive to prevent idle connection drops
        session.headers.update({
            'Connection': 'keep-alive',
            'Keep-Alive': 'timeout=600, max=1000'
        })
        
        return session
    
    def _should_refresh_connection(self, node_name: str) -> bool:
        """
        Check if connection should be refreshed based on age.
        """
        if node_name not in self._connection_times:
            return True
        
        connection_age = time.time() - self._connection_times[node_name]
        return connection_age > self._connection_refresh_interval
    
    def _validate_connection(self, client: pylxd.Client, node_name: str) -> bool:
        """
        Validate if connection is still alive with proper timeout.
        """
        try:
            # Make an actual API call with shorter timeout to verify connection quickly
            client.api.get(timeout=(3, 5))  # 3s connect, 5s read timeout
            return True
        except Exception as e:
            logger.warning(f"Connection validation failed for {node_name}: {e}")
            return False
    
    def _get_client(self, node_name: str) -> pylxd.Client:
        """
        Get or create an LXD client for the specified node.
        Uses certificate-based authentication with optional trust password fallback.
        Implements connection caching with periodic refresh and validation.
        """
        if node_name not in self._node_configs:
            raise LXDConnectionError(f"Unknown node: {node_name}")
        
        # Check if we need to refresh the connection
        should_refresh = self._should_refresh_connection(node_name)
        
        # Return cached client if available, not expired, and still connected
        if node_name in self._clients and not should_refresh:
            if self._validate_connection(self._clients[node_name], node_name):
                return self._clients[node_name]
            else:
                # Connection validation failed, remove from cache and close
                logger.warning(f"Connection to {node_name} is stale, reconnecting...")
                try:
                    # Try to close the old connection gracefully
                    if hasattr(self._clients[node_name], '_api_session'):
                        self._clients[node_name]._api_session.close()
                except Exception as close_err:
                    logger.debug(f"Error closing stale connection: {close_err}")
                del self._clients[node_name]
                if node_name in self._connection_times:
                    del self._connection_times[node_name]
        elif should_refresh and node_name in self._clients:
            # Connection is too old, force refresh
            logger.info(f"Connection to {node_name} is old (>30min), refreshing...")
            try:
                if hasattr(self._clients[node_name], '_api_session'):
                    self._clients[node_name]._api_session.close()
            except Exception as close_err:
                logger.debug(f"Error closing old connection: {close_err}")
            del self._clients[node_name]
            if node_name in self._connection_times:
                del self._connection_times[node_name]
        
        config = self._node_configs[node_name]
        
        try:
            # Try certificate-based authentication first
            client = pylxd.Client(
                endpoint=config.endpoint,
                cert=(config.cert_path, config.key_path),
                verify=config.verify,
                timeout=(10, 30)  # 10s connect timeout, 30s read timeout
            )
            
            # Verify connection with timeout
            client.api.get(timeout=(5, 10))
            
            self._clients[node_name] = client
            self._connection_times[node_name] = time.time()
            logger.info(f"Connected to LXD node: {node_name} at {config.endpoint}")
            return client
            
        except Exception as e:
            # Try trust password if certificate fails
            trust_password = (
                self.settings.lxd_node1_trust_password 
                if node_name == self.settings.lxd_node1_name 
                else self.settings.lxd_node2_trust_password
            )
            
            if trust_password:
                try:
                    client = pylxd.Client(
                        endpoint=config.endpoint,
                        verify=config.verify,
                        timeout=(10, 30)
                    )
                    client.authenticate(trust_password)
                    client.api.get(timeout=(5, 10))
                    self._clients[node_name] = client
                    self._connection_times[node_name] = time.time()
                    logger.info(
                        f"Connected to LXD node via trust password: {node_name}"
                    )
                    return client
                except Exception as auth_error:
                    logger.error(
                        f"Trust password auth failed for {node_name}: {auth_error}"
                    )
            
            logger.error(f"Failed to connect to LXD node {node_name}: {e}")
            raise LXDConnectionError(
                f"Cannot connect to {node_name}: {str(e)}"
            )
    
    def get_node_names(self) -> List[str]:
        """Get list of configured node names."""
        return list(self._node_configs.keys())
    
    def _find_instance_in_projects(self, client: pylxd.Client, name: str):
        """
        Find an instance by name across all projects.
        Returns tuple of (instance, project_name) or (None, None) if not found.
        """
        try:
            # Get all projects
            projects = client.projects.all()
            project_names = [p.name for p in projects]
        except Exception as e:
            logger.warning(f"Could not list projects, using default: {e}")
            project_names = ["default"]
        
        # Search in each project
        for project_name in project_names:
            try:
                # Try to get instance from this project using API directly
                response = client.api.instances[name].get(params={'project': project_name})
                
                # If successful, create instance object from the response
                instance_data = response.json()['metadata']
                
                # Create a mock instance-like object with the data we need
                class InstanceWrapper:
                    def __init__(self, data, client, project):
                        self._data = data
                        self._client = client
                        self._project = project
                        self.name = data.get('name', '')
                        self.status = data.get('status', 'Unknown')
                        self.status_code = data.get('status_code', 0)
                        self.architecture = data.get('architecture', '')
                        self.created_at = data.get('created_at')
                        self.last_used_at = data.get('last_used_at')
                        self.description = data.get('description', '')
                        self.type = data.get('type', 'container')
                        self.config = data.get('config', {})
                        self.profiles = data.get('profiles', [])
                    
                    def start(self, wait=True):
                        self._client.api.instances[self.name].state.put(
                            json={'action': 'start'},
                            params={'project': self._project}
                        )
                    
                    def stop(self, force=False, wait=True, timeout=30):
                        self._client.api.instances[self.name].state.put(
                            json={'action': 'stop', 'force': force, 'timeout': timeout},
                            params={'project': self._project}
                        )
                    
                    def restart(self, force=False, wait=True, timeout=30):
                        self._client.api.instances[self.name].state.put(
                            json={'action': 'restart', 'force': force, 'timeout': timeout},
                            params={'project': self._project}
                        )
                    
                    def delete(self, wait=True):
                        self._client.api.instances[self.name].delete(params={'project': self._project})
                    
                    def sync(self):
                        response = self._client.api.instances[self.name].get(params={'project': self._project})
                        self._data = response.json()['metadata']
                        self.status = self._data.get('status', 'Unknown')
                        self.status_code = self._data.get('status_code', 0)
                    
                    def state(self):
                        """Get instance state including metrics"""
                        response = self._client.api.instances[self.name].state.get(params={'project': self._project})
                        state_data = response.json()['metadata']
                        
                        # Create a simple object to hold state data
                        class StateWrapper:
                            def __init__(self, data):
                                self.cpu = data.get('cpu', {})
                                self.memory = data.get('memory', {})
                                self.disk = data.get('disk', {})
                                self.network = data.get('network', {})
                                self.processes = data.get('processes', 0)
                                self.pid = data.get('pid', 0)
                                self.status = data.get('status', 'Unknown')
                                self.started_at = data.get('started_at')
                        
                        return StateWrapper(state_data)
                
                instance = InstanceWrapper(instance_data, client, project_name)
                logger.debug(f"Found instance '{name}' in project '{project_name}'")
                return instance, project_name
                
            except Exception as e:
                # Instance not found in this project or other error
                logger.debug(f"Instance '{name}' not in project '{project_name}': {e}")
                continue
        
        return None, None
    
    def check_nodes_status(self) -> List[NodeStatus]:
        """Check connection status for all nodes."""
        statuses = []
        
        for name, config in self._node_configs.items():
            status = NodeStatus(
                name=name,
                endpoint=config.endpoint,
                connected=False,
            )
            
            try:
                client = self._get_client(name)
                host_info = client.host_info
                
                status.connected = True
                status.server_version = host_info.get("environment", {}).get(
                    "server_version"
                )
                status.api_version = host_info.get("api_version")
                status.auth = host_info.get("auth")
                status.environment = host_info.get("environment")
                
                # Detect node type (microcloud vs lxd)
                # MicroCloud typically has clustering enabled and specific environment markers
                try:
                    cluster_enabled = host_info.get("environment", {}).get("server_clustered", False)
                    server_name = host_info.get("environment", {}).get("server_name", "")
                    
                    # Check if this is part of MicroCloud by looking at server name or clustering
                    if cluster_enabled and ("micro" in server_name.lower() or "microcloud" in str(host_info).lower()):
                        status.node_type = "microcloud"
                    else:
                        status.node_type = "lxd"
                except Exception as type_err:
                    logger.debug(f"Could not determine node type for {name}: {type_err}")
                    status.node_type = "lxd"  # default to lxd
                
                # Get node resources
                try:
                    resources_data = self.get_node_resources(name)
                    
                    # Get GPU information
                    gpu_total = 0
                    gpu_used = 0
                    try:
                        raw_resources = client.resources
                        gpu_info = raw_resources.get("gpu", {})
                        gpu_cards = gpu_info.get("cards", [])
                        gpu_total = len(gpu_cards)
                        
                        # Count GPUs in use by checking instances
                        instances = client.instances.all()
                        for instance in instances:
                            if instance.status == "Running":
                                config = instance.config or {}
                                # Check for GPU device assignments
                                devices = getattr(instance, 'devices', {}) or {}
                                for device_name, device_config in devices.items():
                                    if device_config.get('type') == 'gpu':
                                        gpu_used += 1
                                        break  # count once per instance
                    except Exception as gpu_err:
                        logger.debug(f"Could not get GPU info for {name}: {gpu_err}")
                    
                    status.resources = NodeResources(
                        cpu_total=resources_data.get("cpu_total", 0),
                        cpu_used=resources_data.get("cpu_total", 0) - resources_data.get("cpu_available", 0),
                        cpu_available=resources_data.get("cpu_available", 0),
                        cpu_sockets=resources_data.get("cpu_sockets", 0),
                        memory_total=resources_data.get("memory_total", 0),
                        memory_used=resources_data.get("memory_total", 0) - resources_data.get("memory_available", 0),
                        memory_available=resources_data.get("memory_available", 0),
                        gpu_total=gpu_total,
                        gpu_used=gpu_used,
                        gpu_available=gpu_total - gpu_used,
                        storage_total=resources_data.get("storage_total", 0),
                        storage_available=resources_data.get("storage_available", 0),
                        storage_pools=resources_data.get("storage_pools", []),
                    )
                except Exception as res_err:
                    logger.warning(f"Could not get resources for {name}: {res_err}")
                
            except Exception as e:
                status.error = str(e)
                logger.warning(f"Node {name} health check failed: {e}")
            
            statuses.append(status)
        
        return statuses
    
    def get_node_resources(self, node_name: str) -> Dict[str, Any]:
        """Get available (unused) resources for a specific node."""
        try:
            client = self._get_client(node_name)
            
            # get system resources
            resources_data = client.resources
            
            # extract CPU info
            cpu_info = resources_data.get("cpu", {})
            cpu_total = cpu_info.get("total", 0)
            cpu_sockets = len(cpu_info.get("sockets", []))
            
            # extract memory info
            memory_info = resources_data.get("memory", {})
            memory_total = memory_info.get("total", 0)
            memory_used = memory_info.get("used", 0)
            memory_available = memory_total - memory_used
            
            # get all running instances to calculate CPU usage
            try:
                instances = client.instances.all()
                cpu_used = 0
                for instance in instances:
                    if instance.status == "Running":
                        # count CPU limits from instance config
                        config = instance.config or {}
                        limits_cpu = config.get("limits.cpu")
                        if limits_cpu:
                            try:
                                cpu_used += int(limits_cpu)
                            except:
                                pass
                cpu_available = cpu_total - cpu_used
                logger.info(f"CPU on {node_name}: {cpu_total} total, {cpu_used} used, {cpu_available} available")
            except Exception as e:
                logger.warning(f"Could not calculate CPU usage for {node_name}: {e}")
                cpu_available = cpu_total
            
            # get storage pools
            storage_pools = []
            try:
                pools = client.storage_pools.all()
                logger.info(f"Found {len(pools)} storage pools on {node_name}")
                for pool in pools:
                    try:
                        # use API directly to get pool resources
                        pool_resources_response = client.api.storage_pools[pool.name].resources.get()
                        pool_resources = pool_resources_response.json().get("metadata", {})
                        space_info = pool_resources.get("space", {})
                        space_total = space_info.get("total", 0)
                        space_used = space_info.get("used", 0)
                        space_available = space_total - space_used
                        logger.info(f"Pool {pool.name}: {space_total} bytes total, {space_used} bytes used, {space_available} available")
                        storage_pools.append({
                            "name": pool.name,
                            "driver": pool.driver,
                            "space_total": space_total,
                            "space_used": space_used,
                            "space_available": space_available,
                        })
                    except Exception as pool_err:
                        logger.warning(f"Could not get resources for pool {pool.name}: {pool_err}")
            except Exception as e:
                logger.warning(f"Could not get storage pools for {node_name}: {e}")
            
            # calculate available storage
            storage_available = sum(p.get("space_available", 0) for p in storage_pools)
            logger.info(f"Storage for {node_name}: {storage_available} bytes available ({len(storage_pools)} pools)")
            
            return {
                "cpu_total": cpu_total,
                "cpu_available": cpu_available,
                "cpu_sockets": cpu_sockets,
                "memory_total": memory_total,
                "memory_available": memory_available,
                "storage_total": sum(p.get("space_total", 0) for p in storage_pools),
                "storage_available": storage_available,
                "storage_pools": storage_pools,
            }
            
        except Exception as e:
            logger.error(f"Error getting resources for {node_name}: {e}")
            raise LXDOperationError(f"Failed to get node resources: {str(e)}")
    
    def _parse_vm_status(self, status: str, status_code: int) -> VMStatus:
        """Convert LXD status string to VMStatus enum."""
        status_map = {
            "Running": VMStatus.RUNNING,
            "Stopped": VMStatus.STOPPED,
            "Frozen": VMStatus.FROZEN,
            "Error": VMStatus.ERROR,
        }
        return status_map.get(status, VMStatus.UNKNOWN)
    
    def _extract_ip_addresses(self, instance) -> List[str]:
        """Extract IP addresses from instance network state."""
        ip_addresses = []
        
        try:
            if instance.status != "Running":
                return ip_addresses
            
            state = instance.state()
            if state and state.network:
                for iface_name, iface_data in state.network.items():
                    if iface_name == "lo":
                        continue
                    
                    for addr in iface_data.get("addresses", []):
                        if addr.get("family") == "inet":
                            ip_addresses.append(addr.get("address"))
                        elif addr.get("family") == "inet6":
                            ip_addr = addr.get("address")
                            # Skip link-local addresses
                            if not ip_addr.startswith("fe80"):
                                ip_addresses.append(ip_addr)
        except Exception as e:
            logger.debug(f"Could not get IP addresses for {instance.name}: {e}")
        
        return ip_addresses
    
    def _get_resource_usage(self, instance) -> Optional[ResourceUsage]:
        """Get resource usage for a running instance."""
        try:
            if instance.status != "Running":
                return None
            
            state = instance.state()
            if not state:
                return None
            
            resources = ResourceUsage()
            
            # CPU usage
            if state.cpu:
                resources.cpu_usage = state.cpu.get("usage")
            
            # Memory usage
            if state.memory:
                resources.memory_usage = state.memory.get("usage")
                resources.memory_limit = state.memory.get("usage_peak")
            
            # Disk usage
            if state.disk:
                resources.disk_usage = {
                    k: v.get("usage", 0) for k, v in state.disk.items()
                }
            
            # Network counters
            if state.network:
                resources.network_counters = {}
                for iface, data in state.network.items():
                    if iface != "lo":
                        resources.network_counters[iface] = {
                            "bytes_received": data.get("counters", {}).get(
                                "bytes_received", 0
                            ),
                            "bytes_sent": data.get("counters", {}).get(
                                "bytes_sent", 0
                            ),
                            "packets_received": data.get("counters", {}).get(
                                "packets_received", 0
                            ),
                            "packets_sent": data.get("counters", {}).get(
                                "packets_sent", 0
                            ),
                        }
            
            return resources
            
        except Exception as e:
            logger.debug(f"Could not get resources for {instance.name}: {e}")
            return None
    
    def _instance_to_vm_info(
        self, 
        instance, 
        node_name: str, 
        node_endpoint: str
    ) -> VMInfo:
        """Convert pylxd instance to VMInfo model."""
        return VMInfo(
            name=instance.name,
            status=self._parse_vm_status(instance.status, instance.status_code),
            status_code=instance.status_code,
            ip_addresses=self._extract_ip_addresses(instance),
            host=node_name,
            host_endpoint=node_endpoint,
            architecture=instance.architecture,
            created_at=instance.created_at,
            last_used_at=instance.last_used_at,
            description=instance.description,
            type=instance.type,
            resources=self._get_resource_usage(instance),
            config=dict(instance.config) if instance.config else None,
            profiles=list(instance.profiles) if instance.profiles else [],
        )
    
    async def list_all_vms(self) -> Tuple[List[VMInfo], List[str]]:
        """
        List all VMs across all configured LXD nodes and all projects.
        Returns tuple of (vm_list, connected_nodes).
        Includes retry logic for transient connection failures.
        """
        all_vms: List[VMInfo] = []
        connected_nodes: List[str] = []
        
        for node_name, config in self._node_configs.items():
            retry_count = 0
            max_retries = 2
            
            while retry_count <= max_retries:
                try:
                    client = self._get_client(node_name)
                    connected_nodes.append(node_name)
                    break  # Success, exit retry loop
                except LXDConnectionError as e:
                    retry_count += 1
                    if retry_count > max_retries:
                        logger.warning(f"Could not connect to node {node_name} after {max_retries} retries: {e}")
                        break  # Give up after retries
                    logger.info(f"Retrying connection to {node_name} ({retry_count}/{max_retries})...")
                    # Force connection cleanup on retry
                    if node_name in self._clients:
                        del self._clients[node_name]
                    if node_name in self._connection_times:
                        del self._connection_times[node_name]
                    time.sleep(0.5 * retry_count)  # Brief exponential backoff
                    continue
            
            # Skip if connection failed after retries
            if node_name not in connected_nodes:
                continue
            
            try:
                client = self._get_client(node_name)
                
                # Get all projects on this node
                try:
                    projects = client.projects.all()
                    project_names = [p.name for p in projects]
                    logger.info(f"Found {len(project_names)} projects on {node_name}: {project_names}")
                except Exception as e:
                    logger.warning(f"Could not list projects on {node_name}, using default: {e}")
                    project_names = ["default"]
                
                # Iterate through all projects
                for project_name in project_names:
                    try:
                        # Get instances for this specific project using API call
                        # pylxd doesn't support project parameter in all(), so we use API directly
                        response = client.api.instances.get(params={'project': project_name, 'recursion': 1})
                        instances_data = response.json()['metadata']
                        
                        logger.debug(f"Found {len(instances_data)} instances in project '{project_name}' on {node_name}")
                        
                        # Parse each instance data
                        for instance_data in instances_data:
                            try:
                                # Extract relevant fields from API response
                                vm_info = VMInfo(
                                    name=instance_data.get('name', ''),
                                    status=self._parse_vm_status(
                                        instance_data.get('status', 'Unknown'),
                                        instance_data.get('status_code', 0)
                                    ),
                                    status_code=instance_data.get('status_code', 0),
                                    ip_addresses=[],  # Will be populated later if needed
                                    host=node_name,
                                    host_endpoint=config.endpoint,
                                    architecture=instance_data.get('architecture', ''),
                                    created_at=instance_data.get('created_at'),
                                    last_used_at=instance_data.get('last_used_at'),
                                    description=instance_data.get('description', ''),
                                    type=instance_data.get('type', 'container'),
                                    resources=None,
                                    config=instance_data.get('config', {}),
                                    profiles=instance_data.get('profiles', []),
                                )
                                
                                # Add project information
                                if vm_info.config is None:
                                    vm_info.config = {}
                                vm_info.config['project'] = project_name
                                
                                all_vms.append(vm_info)
                            except Exception as e:
                                logger.error(
                                    f"Error processing instance in project '{project_name}' on {node_name}: {e}"
                                )
                    except Exception as e:
                        logger.error(f"Error listing instances in project '{project_name}' on {node_name}: {e}")
                        
            except LXDConnectionError as e:
                logger.warning(f"Could not connect to node {node_name}: {e}")
            except Exception as e:
                logger.error(f"Error listing VMs from {node_name}: {e}")
        
        return all_vms, connected_nodes
    
    async def get_vm(self, name: str, host: str) -> Optional[VMInfo]:
        """Get a specific VM by name and host (searches all projects). Includes retry logic."""
        max_retries = 2
        for attempt in range(max_retries + 1):
            try:
                client = self._get_client(host)
                config = self._node_configs[host]
                break
            except LXDConnectionError as e:
                if attempt == max_retries:
                    raise LXDOperationError(f"Failed to connect to {host} after {max_retries} retries: {e}")
                logger.info(f"Retrying get_vm connection to {host} ({attempt + 1}/{max_retries})...")
                if host in self._clients:
                    del self._clients[host]
                time.sleep(0.5)
                continue
        
        try:
            client = self._get_client(host)
            config = self._node_configs[host]
            
            # Find instance across all projects
            instance, project_name = self._find_instance_in_projects(client, name)
            
            if instance is None:
                return None
            
            vm_info = self._instance_to_vm_info(instance, host, config.endpoint)
            if vm_info.config is None:
                vm_info.config = {}
            vm_info.config['project'] = project_name
            
            return vm_info
            
        except Exception as e:
            logger.error(f"Error getting VM {name} from {host}: {e}")
            raise LXDOperationError(f"Failed to get VM: {str(e)}")
    
    async def start_vm(self, name: str, host: str, force: bool = False) -> VMInfo:
        """Start a VM (searches all projects). Includes retry logic."""
        max_retries = 2
        for attempt in range(max_retries + 1):
            try:
                client = self._get_client(host)
                config = self._node_configs[host]
                break
            except LXDConnectionError as e:
                if attempt == max_retries:
                    raise LXDOperationError(f"Failed to connect to {host}: {e}")
                logger.info(f"Retrying start_vm connection to {host} ({attempt + 1}/{max_retries})...")
                if host in self._clients:
                    del self._clients[host]
                time.sleep(0.5)
                continue
        
        try:
            client = self._get_client(host)
            config = self._node_configs[host]
            
            instance, project_name = self._find_instance_in_projects(client, name)
            
            if instance is None:
                raise LXDOperationError(f"VM {name} not found on {host}")
            
            if instance.status == "Running":
                vm_info = self._instance_to_vm_info(instance, host, config.endpoint)
            else:
                instance.start(wait=True)
                instance.sync()
                logger.info(f"Started VM {name} on {host} (project: {project_name})")
                vm_info = self._instance_to_vm_info(instance, host, config.endpoint)
            
            if vm_info.config is None:
                vm_info.config = {}
            vm_info.config['project'] = project_name
            
            return vm_info
            
        except LXDAPIException as e:
            raise LXDOperationError(f"Failed to start VM: {str(e)}")
    
    async def stop_vm(
        self, 
        name: str, 
        host: str, 
        force: bool = False,
        timeout: int = 30
    ) -> VMInfo:
        """Stop a VM (searches all projects). Includes retry logic."""
        max_retries = 2
        for attempt in range(max_retries + 1):
            try:
                client = self._get_client(host)
                config = self._node_configs[host]
                break
            except LXDConnectionError as e:
                if attempt == max_retries:
                    raise LXDOperationError(f"Failed to connect to {host}: {e}")
                logger.info(f"Retrying stop_vm connection to {host} ({attempt + 1}/{max_retries})...")
                if host in self._clients:
                    del self._clients[host]
                time.sleep(0.5)
                continue
        
        try:
            client = self._get_client(host)
            config = self._node_configs[host]
            
            instance, project_name = self._find_instance_in_projects(client, name)
            
            if instance is None:
                raise LXDOperationError(f"VM {name} not found on {host}")
            
            if instance.status == "Stopped":
                vm_info = self._instance_to_vm_info(instance, host, config.endpoint)
            else:
                instance.stop(force=force, wait=True, timeout=timeout)
                instance.sync()
                logger.info(f"Stopped VM {name} on {host} (project: {project_name})")
                vm_info = self._instance_to_vm_info(instance, host, config.endpoint)
            
            if vm_info.config is None:
                vm_info.config = {}
            vm_info.config['project'] = project_name
            
            return vm_info
            
        except LXDAPIException as e:
            raise LXDOperationError(f"Failed to stop VM: {str(e)}")
    
    async def restart_vm(
        self, 
        name: str, 
        host: str, 
        force: bool = False,
        timeout: int = 30
    ) -> VMInfo:
        """Restart a VM (searches all projects)."""
        try:
            client = self._get_client(host)
            config = self._node_configs[host]
            
            instance, project_name = self._find_instance_in_projects(client, name)
            
            if instance is None:
                raise LXDOperationError(f"VM {name} not found on {host}")
            
            instance.restart(force=force, wait=True, timeout=timeout)
            instance.sync()
            
            logger.info(f"Restarted VM {name} on {host} (project: {project_name})")
            vm_info = self._instance_to_vm_info(instance, host, config.endpoint)
            
            if vm_info.config is None:
                vm_info.config = {}
            vm_info.config['project'] = project_name
            
            return vm_info
            
        except LXDAPIException as e:
            raise LXDOperationError(f"Failed to restart VM: {str(e)}")
    
    async def delete_vm(
        self, 
        name: str, 
        host: str, 
        force: bool = False
    ) -> bool:
        """Delete a VM (searches all projects)."""
        try:
            client = self._get_client(host)
            
            instance, project_name = self._find_instance_in_projects(client, name)
            
            if instance is None:
                raise LXDOperationError(f"VM {name} not found on {host}")
            
            # Stop if running and force is True
            if instance.status == "Running":
                if force:
                    instance.stop(force=True, wait=True)
                else:
                    raise LXDOperationError(
                        f"VM {name} is running. Stop it first or use force=true"
                    )
            
            instance.delete(wait=True)
            
            logger.info(f"Deleted VM {name} from {host} (project: {project_name})")
            return True
            
        except LXDAPIException as e:
            raise LXDOperationError(f"Failed to delete VM: {str(e)}")
    
    async def create_vm(
        self,
        name: str,
        host: str,
        image: str,
        instance_type: str = "virtual-machine",
        profiles: Optional[List[str]] = None,
        config: Optional[Dict[str, str]] = None,
        cloud_init: Optional[str] = None,
        devices: Optional[Dict[str, Dict[str, str]]] = None,
        start_on_create: bool = True,
    ) -> VMInfo:
        """Create a new VM."""
        try:
            client = self._get_client(host)
            node_config = self._node_configs[host]
            
            # Build instance configuration
            instance_config = config or {}
            
            # Add cloud-init if provided
            if cloud_init:
                instance_config["user.user-data"] = cloud_init
            
            # Determine source configuration
            source = {"type": "image"}
            
            # Check if image is a fingerprint or alias
            if len(image) == 64:  # Fingerprint
                source["fingerprint"] = image
            else:
                source["alias"] = image
            
            # Create instance definition
            instance_def = {
                "name": name,
                "source": source,
                "type": instance_type,
                "profiles": profiles or ["default"],
                "config": instance_config,
            }
            
            if devices:
                instance_def["devices"] = devices
            
            # Create the instance
            if instance_type == "virtual-machine":
                instance = client.virtual_machines.create(
                    instance_def, 
                    wait=True
                )
            else:
                instance = client.containers.create(
                    instance_def, 
                    wait=True
                )
            
            logger.info(f"Created {instance_type} {name} on {host}")
            
            # Start if requested
            if start_on_create:
                instance.start(wait=True)
                instance.sync()
                logger.info(f"Started {name} on {host}")
            
            return self._instance_to_vm_info(instance, host, node_config.endpoint)
            
        except LXDAPIException as e:
            raise LXDOperationError(f"Failed to create VM: {str(e)}")
    
    async def list_images(self, host: str) -> List[ImageInfo]:
        """List available images on a host."""
        try:
            client = self._get_client(host)
            images = []
            
            for image in client.images.all():
                aliases = [a.get("name", "") for a in image.aliases] if image.aliases else []
                
                images.append(ImageInfo(
                    fingerprint=image.fingerprint,
                    aliases=aliases,
                    description=image.properties.get("description", "") if image.properties else "",
                    architecture=image.architecture,
                    size=image.size,
                    upload_date=image.uploaded_at,
                    public=image.public,
                    type=image.type,
                ))
            
            return images
            
        except Exception as e:
            logger.error(f"Error listing images from {host}: {e}")
            raise LXDOperationError(f"Failed to list images: {str(e)}")
    
    async def list_projects(self, host: str) -> List[Dict[str, Any]]:
        """List all projects on a specific LXD host."""
        try:
            client = self._get_client(host)
            projects = client.projects.all()
            
            project_list = []
            for project in projects:
                project_info = {
                    "name": project.name,
                    "description": project.description or "",
                    "config": project.config or {},
                    "used_by": project.used_by or [],
                    "host": host,
                }
                project_list.append(project_info)
            
            logger.info(f"Listed {len(project_list)} projects from {host}")
            return project_list
            
        except Exception as e:
            logger.error(f"Error listing projects from {host}: {e}")
            raise LXDOperationError(f"Failed to list projects: {str(e)}")
    
    async def create_project(
        self, 
        host: str, 
        name: str, 
        description: Optional[str] = None,
        config: Optional[Dict[str, str]] = None,
        max_cpu: Optional[int] = None,
        max_ram: Optional[str] = None,
        max_storage: Optional[str] = None
    ) -> Dict[str, Any]:
        """Create a new project on a specific LXD host."""
        try:
            client = self._get_client(host)
            
            # prepare project config with default features
            project_config = config or {
                "features.images": "true",
                "features.profiles": "true",
                "features.storage.volumes": "true",
                "features.networks": "true",
            }
            
            # add resource limits if provided
            if max_cpu is not None:
                project_config["limits.cpu"] = str(max_cpu)
            if max_ram is not None:
                project_config["limits.memory"] = max_ram
            if max_storage is not None:
                project_config["limits.disk"] = max_storage
            
            # create project using API directly
            project_data = {
                "name": name,
                "description": description or "",
                "config": project_config
            }
            
            # use API endpoint directly
            client.api.projects.post(json=project_data)
            
            # get the created project
            project = client.projects.get(name)
            
            logger.info(f"Created project '{name}' on {host}")
            
            return {
                "name": project.name,
                "description": project.description or "",
                "config": project.config or {},
                "used_by": project.used_by or [],
                "host": host,
            }
            
        except LXDAPIException as e:
            logger.error(f"LXD API error creating project '{name}' on {host}: {e}")
            raise LXDOperationError(f"Failed to create project: {str(e)}")
        except Exception as e:
            logger.error(f"Error creating project '{name}' on {host}: {e}")
            raise LXDOperationError(f"Failed to create project: {str(e)}")
    
    async def update_project(
        self, 
        host: str, 
        project_name: str, 
        description: Optional[str] = None,
        max_cpu: Optional[int] = None,
        max_ram: Optional[str] = None,
        max_storage: Optional[str] = None
    ) -> Dict[str, Any]:
        """Update an existing project's description and resource limits."""
        try:
            client = self._get_client(host)
            
            # get the current project
            project = client.projects.get(project_name)
            
            # update description if provided
            if description is not None:
                project.description = description
            
            # update resource limits if provided
            if max_cpu is not None:
                project.config["limits.cpu"] = str(max_cpu)
            if max_ram is not None:
                project.config["limits.memory"] = max_ram
            if max_storage is not None:
                project.config["limits.disk"] = max_storage
            
            # save the updated project
            project.save()
            
            logger.info(f"Updated project '{project_name}' on {host}")
            
            return {
                "name": project.name,
                "description": project.description or "",
                "config": project.config or {},
                "used_by": project.used_by or [],
                "host": host,
            }
            
        except NotFound:
            logger.error(f"Project '{project_name}' not found on {host}")
            raise LXDOperationError(f"Project '{project_name}' not found")
        except LXDAPIException as e:
            logger.error(f"LXD API error updating project '{project_name}' on {host}: {e}")
            raise LXDOperationError(f"Failed to update project: {str(e)}")
        except Exception as e:
            logger.error(f"Error updating project '{project_name}' on {host}: {e}")
            raise LXDOperationError(f"Failed to update project: {str(e)}")
    
    async def delete_project(self, host: str, name: str) -> None:
        """Delete a project from a specific LXD host."""
        try:
            client = self._get_client(host)
            
            # get the project first
            project = client.projects.get(name)
            
            # delete the project
            project.delete()
            
            logger.info(f"Deleted project '{name}' from {host}")
            
        except NotFound:
            logger.error(f"Project '{name}' not found on {host}")
            raise LXDOperationError(f"Project '{name}' not found")
        except LXDAPIException as e:
            logger.error(f"LXD API error deleting project '{name}' from {host}: {e}")
            raise LXDOperationError(f"Failed to delete project: {str(e)}")
        except Exception as e:
            logger.error(f"Error deleting project '{name}' from {host}: {e}")
            raise LXDOperationError(f"Failed to delete project: {str(e)}")

    async def get_instance_metrics(
        self, 
        host: str, 
        instance_name: str,
        project: str = "default"
    ) -> InstanceMetrics:
        """
        Get real-time metrics for a specific instance.
        Returns CPU, memory, disk, network usage with timestamps.
        """
        try:
            client = self._get_client(host)
            
            # Find instance across all projects
            instance, found_project = self._find_instance_in_projects(client, instance_name)
            
            if not instance:
                raise LXDOperationError(f"Instance '{instance_name}' not found on {host}")
            
            # Get current state
            state = instance.state()
            
            # Parse status
            status = self._parse_vm_status(instance.status, instance.status_code)
            
            # Initialize metrics
            metrics = InstanceMetrics(
                instance_name=instance_name,
                host=host,
                status=status,
            )
            
            # Only get metrics for running instances
            if instance.status != "Running" or not state:
                return metrics
            
            # CPU usage - calculate from cumulative nanoseconds delta
            if state.cpu and state.cpu.get("usage"):
                import time
                current_usage_ns = state.cpu.get("usage")
                current_time = time.time()
                
                cache_key = f"{host}:{instance_name}"
                
                if cache_key in self._cpu_history:
                    # Calculate delta
                    prev_data = self._cpu_history[cache_key]
                    prev_usage_ns = prev_data["usage_ns"]
                    prev_time = prev_data["timestamp"]
                    
                    time_delta = current_time - prev_time
                    usage_delta_ns = current_usage_ns - prev_usage_ns
                    
                    # Calculate percentage: (delta_ns / time_delta_s) / 1e9 * 100
                    # This gives us CPU usage as percentage across all cores
                    if time_delta > 0:
                        cpu_percent = (usage_delta_ns / (time_delta * 1e9)) * 100
                        # Cap at reasonable value (shouldn't exceed num_cores * 100)
                        metrics.cpu_usage_percent = round(min(cpu_percent, 800.0), 2)
                
                # Store current values for next calculation
                self._cpu_history[cache_key] = {
                    "usage_ns": current_usage_ns,
                    "timestamp": current_time
                }
            
            # Memory usage
            if state.memory:
                metrics.memory_used_bytes = state.memory.get("usage", 0)
                metrics.memory_total_bytes = state.memory.get("total", 0)
                if metrics.memory_total_bytes > 0:
                    metrics.memory_usage_percent = round(
                        (metrics.memory_used_bytes / metrics.memory_total_bytes) * 100, 2
                    )
            
            # Disk usage
            if state.disk:
                metrics.disk_usage_bytes = {
                    device: data.get("usage", 0)
                    for device, data in state.disk.items()
                }
            
            # Network counters
            if state.network:
                for iface_name, iface_data in state.network.items():
                    if iface_name == "lo":
                        continue
                    counters = iface_data.get("counters", {})
                    metrics.network_rx_bytes[iface_name] = counters.get("bytes_received", 0)
                    metrics.network_tx_bytes[iface_name] = counters.get("bytes_sent", 0)
            
            # Process count
            if state.processes:
                metrics.processes = state.processes
            
            # PID
            if hasattr(state, 'pid') and state.pid:
                metrics.pid = state.pid
            
            # Uptime - use status timestamps from instance state
            try:
                if hasattr(state, 'started_at') and state.started_at:
                    from datetime import datetime, timezone
                    started_at_str = state.started_at
                    # Parse ISO format timestamp - LXD returns RFC3339
                    # Remove 'Z' and add timezone explicitly
                    if started_at_str.endswith('Z'):
                        started_at_str = started_at_str[:-1] + '+00:00'
                    started_at = datetime.fromisoformat(started_at_str)
                    now = datetime.now(timezone.utc)
                    uptime_delta = now - started_at
                    metrics.uptime_seconds = int(uptime_delta.total_seconds())
                else:
                    # started_at is None or not found - try last_used_at from instance
                    if instance.last_used_at and instance.status == "Running":
                        from datetime import datetime, timezone
                        last_used_str = instance.last_used_at
                        if last_used_str.endswith('Z'):
                            last_used_str = last_used_str[:-1] + '+00:00'
                        last_used = datetime.fromisoformat(last_used_str)
                        now = datetime.now(timezone.utc)
                        uptime_delta = now - last_used
                        metrics.uptime_seconds = int(uptime_delta.total_seconds())
            except Exception as e:
                logger.warning(f"Could not calculate uptime for {instance_name}: {e}")
            
            # Base image
            if instance.config and instance.config.get('image.description'):
                metrics.base_image = instance.config.get('image.description')
            elif instance.config and instance.config.get('volatile.base_image'):
                metrics.base_image = instance.config.get('volatile.base_image')
            
            # IP addresses - separate IPv4 and IPv6
            if state.network:
                for iface_name, iface_data in state.network.items():
                    if iface_name == "lo":
                        continue
                    for addr in iface_data.get("addresses", []):
                        ip = addr.get("address")
                        family = addr.get("family")
                        if family == "inet":
                            metrics.ipv4_addresses.append(ip)
                        elif family == "inet6" and not ip.startswith("fe80"):
                            metrics.ipv6_addresses.append(ip)
            
            return metrics
            
        except NotFound:
            logger.error(f"Instance '{instance_name}' not found on {host}")
            raise LXDOperationError(f"Instance '{instance_name}' not found")
        except LXDAPIException as e:
            logger.error(f"LXD API error getting metrics for '{instance_name}': {e}")
            raise LXDOperationError(f"Failed to get metrics: {str(e)}")
        except Exception as e:
            logger.error(f"Error getting metrics for '{instance_name}' on {host}: {e}")
            raise LXDOperationError(f"Failed to get metrics: {str(e)}")


# Singleton instance
_lxd_service: Optional[LXDService] = None


def get_lxd_service() -> LXDService:
    """Get or create the LXD service singleton."""
    global _lxd_service
    if _lxd_service is None:
        _lxd_service = LXDService()
    return _lxd_service
