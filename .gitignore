# Local operator scripts stay out of the repo, but scripts/checks holds the structural guards
# that make test-frontend and CI run, so that directory is tracked.
scripts/*
!scripts/checks/
# note: the operator tooling (scripts/orcastra-ops.sh) is deliberately NOT tracked. It is
# handed to an operator as text and kept on the deployment VM, so the published runbook
# documents the procedure rather than telling readers to fetch a script.
!scripts/setup_opensearch_dashboards.sh

# Artefacts orcastra-ops.sh writes when run inside a clone
backups/
.orcastra-ops.lock/
config/
backup/
documentation/
CHANGELOG.md
.github/instructions/

# Claude Code (local AI tooling - not committed to this public repo)
.claude/
CLAUDE.md

# graphify knowledge graph (local tooling, never committed)
graphify-out/
.graphifyignore
