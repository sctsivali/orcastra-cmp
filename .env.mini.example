# Orcastra Mini: environment for docker-compose.mini.yml. Copy to .env (or .env.mini for the
# Makefile targets) and fill every empty value. Generate each secret with: openssl rand -hex 32

# Deployment
CONTAINER_PREFIX=orcastra-mini
# The Compose project name. Keep it equal to CONTAINER_PREFIX: plain `docker compose` commands,
# the installer and upgrades then all reach the same containers and volumes.
COMPOSE_PROJECT_NAME=orcastra-mini
APP_VERSION=1.0.0
HTTPS_PORT=6969
# The address nginx listens on; 0.0.0.0 is every interface.
HTTPS_BIND=0.0.0.0
UPLOADS_DIR=/var/orcastra/uploads

# Database
POSTGRES_USER=orcastra
POSTGRES_PASSWORD=
POSTGRES_DB=orcastra
DATABASE_URL=postgresql+asyncpg://orcastra:<same as POSTGRES_PASSWORD>@postgres:5432/orcastra

# Secrets (32 characters or more each; LOCAL_JWT_SECRET must differ from SECRET_KEY)
SECRET_KEY=
LOCAL_JWT_SECRET=
NEXTAUTH_SECRET=
AUTH_PROXY_SECRET=
# Enrolls the first Administrator while none exists. Clear it afterwards.
BOOTSTRAP_ADMIN_TOKEN=

# Sessions and certificates
LOCAL_JWT_TTL_SECONDS=900
CLIENT_CERT_TTL_DAYS=365
CERT_SELF_RENEW_ENABLED=true

# Vault (VAULT_TOKEN after Vault is initialised)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_PKI_ROLE=lxd

# URLs: the address operators open, with HTTPS_PORT
NEXTAUTH_URL=https://dashboard.example.com:6969
NEXT_PUBLIC_API_URL=https://dashboard.example.com:6969
CORS_ORIGINS=https://dashboard.example.com:6969

# Audit log: 0 keeps every row
AUDIT_DB_ENABLED=true
AUDIT_DB_RETENTION_DAYS=0
