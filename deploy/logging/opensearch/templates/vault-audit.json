{
  "index_patterns": [
    "vault-audit-*"
  ],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": "1",
        "number_of_replicas": "0",
        "default_pipeline": "vault-audit-ingest"
      }
    },
    "mappings": {
      "properties": {
        "request": {
          "properties": {
            "client_token": {
              "type": "keyword"
            },
            "path": {
              "type": "keyword"
            },
            "namespace_id": {
              "type": "keyword"
            },
            "namespace": {
              "type": "keyword"
            },
            "remote_port": {
              "type": "integer"
            },
            "id": {
              "type": "keyword"
            },
            "mount_type": {
              "type": "keyword"
            },
            "remote_address": {
              "type": "ip"
            },
            "client_token_accessor": {
              "type": "keyword"
            },
            "operation": {
              "type": "keyword"
            },
            "mount_accessor": {
              "type": "keyword"
            },
            "client_id": {
              "type": "keyword"
            }
          }
        },
        "cluster": {
          "type": "keyword"
        },
        "environment": {
          "type": "keyword"
        },
        "@timestamp": {
          "type": "date"
        },
        "auth": {
          "properties": {
            "token_policies": {
              "type": "keyword"
            },
            "client_token": {
              "type": "keyword"
            },
            "accessor": {
              "type": "keyword"
            },
            "policies": {
              "type": "keyword"
            },
            "display_name": {
              "type": "keyword"
            },
            "entity_id": {
              "type": "keyword"
            },
            "token_type": {
              "type": "keyword"
            }
          }
        },
        "response": {
          "properties": {
            "mount_type": {
              "type": "keyword"
            },
            "mount_accessor": {
              "type": "keyword"
            }
          }
        },
        "service": {
          "type": "keyword"
        },
        "time": {
          "type": "date"
        },
        "type": {
          "type": "keyword"
        },
        "error": {
          "type": "text"
        }
      }
    }
  },
  "composed_of": [],
  "priority": 100,
  "version": 2,
  "_meta": {
    "managed_by": "orca-logging",
    "description": "vault-audit: single shard, no replica (single node), monthly routing"
  }
}