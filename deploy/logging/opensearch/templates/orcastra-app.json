{
  "index_patterns": [
    "orcastra-app-*"
  ],
  "priority": 100,
  "template": {
    "settings": {
      "index": {
        "number_of_shards": "1",
        "number_of_replicas": "0",
        "default_pipeline": "monthly-reroute"
      }
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        }
      }
    }
  },
  "_meta": {
    "managed_by": "orca-logging",
    "description": "orcastra-app: single shard, no replica (single node), monthly routing"
  }
}