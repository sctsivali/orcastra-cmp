# Copy to .env next to docker-compose.yml and chmod 600. Never commit .env.
# Logging host address: Tailscale 100.90.90.69, or 10.1.1.40 from the private LAN.
OPENSEARCH_HOST=100.90.90.69
OPENSEARCH_PORT=9200
# Account and password from the logging host: scripts/provision-stack.sh <stack> <env>
OPENSEARCH_USER=fluentbit-STACK-ENV
OPENSEARCH_PASSWORD=CHANGE_ME
# [a-z0-9]+ each; the index becomes containers-<stack>-<env>
SHIPPER_STACK=STACK
SHIPPER_ENV=ENV
# Shown in the "host" field
SHIPPER_HOST=HOSTNAME
