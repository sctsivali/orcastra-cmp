# =============================================================================
# Orcastra Dashboard - Environment Configuration Template
# =============================================================================
#
# IMPORTANT: Copy this file to .env and fill in your values
#            DO NOT commit .env to version control!
#
# All variables marked with [REQUIRED] must be set for the application to work
# Variables marked with [OPTIONAL] have sensible defaults
# =============================================================================

# =============================================================================
# Centralized Version Management
# =============================================================================

# Application Version [OPTIONAL]
# Format: MAJOR.MINOR.PATCH (ex; 1.0.0, 2.1.5)
APP_VERSION=0.3.0

# API metadata [OPTIONAL]
API_TITLE="Orcastra Dashboard API"
API_PREFIX="/api/v1"

# =============================================================================
# PostgreSQL Database Configuration [REQUIRED]
# =============================================================================
POSTGRES_USER=orcastra
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=orcastra_dashboard
POSTGRES_PORT=5432

# Full database connection URL [REQUIRED]
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://orcastra:your_secure_postgres_password_here@postgres:5432/orcastra_dashboard

# =============================================================================
# Backend/API Configuration
# =============================================================================
BACKEND_PORT=4050
DEBUG=false

# Docker container naming prefix [OPTIONAL]
CONTAINER_PREFIX=orcastra-dashboard

# =============================================================================
# Frontend Configuration
# =============================================================================
FRONTEND_PORT=2025

# API URL accessible from the browser [REQUIRED]
# This should be the public-facing URL of your backend API
NEXT_PUBLIC_API_URL=http://your-server-ip:4050

# =============================================================================
# HashiCorp Vault Configuration [REQUIRED when VAULT_ENABLED=true]
# =============================================================================

# Enable Vault integration for certificate and secrets management
VAULT_ENABLED=false

# Vault server address [REQUIRED when VAULT_ENABLED=true]
VAULT_ADDR=http://vault.your-domain.com:8200

# Vault authentication token [REQUIRED when VAULT_ENABLED=true]
# Generate via: vault token create -policy=orcastra-policy
VAULT_TOKEN=hvs.your_vault_token_here

# Vault PKI configuration [OPTIONAL]
VAULT_PKI_ROLE=lxd
VAULT_CLUSTERS_PATH=secret/data/clusters
VAULT_CERT_TTL=720h

# =============================================================================
# Redis Cache Configuration [REQUIRED when REDIS_ENABLED=true]
# =============================================================================

# Enable Redis caching for improved performance
REDIS_ENABLED=true
REDIS_PORT=6381

# Redis connection URL (internal Docker network)
REDIS_URL=redis://redis:6379/0

# Cache TTL Settings (in seconds)
CACHE_TTL_VAULT_METADATA=600
CACHE_TTL_LXD_DATA=60

# =============================================================================
# Security Configuration [REQUIRED]
# =============================================================================

# CORS allowed origins [REQUIRED]
# Use * only for development, specify exact origins in production
# Example: https://dashboard.your-domain.com,https://api.your-domain.com
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100

# Redis cache encryption [REQUIRED when REDIS_ENABLED=true]
REDIS_ENCRYPTION_ENABLED=true

# Encryption key for Redis cache [REQUIRED when REDIS_ENCRYPTION_ENABLED=true]
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REDIS_ENCRYPTION_KEY=your_fernet_key_here

# General secret key for encryption [REQUIRED]
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# =============================================================================
# Read-Only Mode [OPTIONAL]
# =============================================================================
# When set to true, all create, update, delete operations will be blocked
# Useful for demo environments or maintenance mode
READ_ONLY_MODE=false

# =============================================================================
# Authentik OAuth2/OIDC Configuration [REQUIRED for SSO]
# =============================================================================

# Authentik Issuer URL (OpenID Connect Discovery endpoint base) [REQUIRED]
AUTHENTIK_ISSUER=https://auth.your-domain.com/application/o/orcastra-dashboard/

# Authentik Logout URL [REQUIRED]
# This is exposed to the browser for client-side logout redirect
NEXT_PUBLIC_AUTHENTIK_LOGOUT_URL=https://auth.your-domain.com/application/o/orcastra-dashboard/end-session/

# OAuth2 Client Credentials (from Authentik Provider) [REQUIRED]
AUTHENTIK_CLIENT_ID=your_authentik_client_id_here
AUTHENTIK_CLIENT_SECRET=your_authentik_client_secret_here

# =============================================================================
# NextAuth Configuration [REQUIRED]
# =============================================================================

# NextAuth URL must match the frontend URL (including port) [REQUIRED]
NEXTAUTH_URL=http://your-server-ip:2025

# NextAuth Secret for encrypting session cookies [REQUIRED]
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Trust host header (set to true when behind a reverse proxy)
AUTH_TRUST_HOST=true
