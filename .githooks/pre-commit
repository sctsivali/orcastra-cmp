#!/bin/sh
# Refuse a commit whose staged changes carry a secret. Without gitleaks installed the scan is skipped
# with a notice; `make ci-local` and CI scan the same commits again.
if ! command -v gitleaks > /dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, staged secret scan skipped" >&2
  exit 0
fi
exec gitleaks git --staged --redact --no-banner --log-level=warn .
